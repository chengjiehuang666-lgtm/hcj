# ============================================================================
# 环境变量模板 —— 本文件会提交到仓库，**只能放占位符，绝不放真实密钥**
#
# 用法：复制成本地 .env 后填入真实值
#     cp .env.example .env
# .env 已被 .gitignore 忽略，永远不会进入版本库。
# ============================================================================

# ---------- 无密钥的开发模式 ----------
# stub = 用内置假数据响应，用于本地跑通链路与测试（不需要任何 key）
# live = 真实调用供应商 API（需要填下面的 key）
LLM_MODE=stub

# ---------- 主力模型 ----------
# DeepSeek / 通义千问 Qwen / 智谱 GLM 均提供 OpenAI 兼容接口，
# 因此三者共用同一个适配器（openai_compatible），换供应商只改这三行。
LLM_PRIMARY_PROVIDER=deepseek
LLM_PRIMARY_MODEL=deepseek-chat
LLM_PRIMARY_BASE_URL=https://api.deepseek.com/v1
# 真实 key 只写在 .env 里，不要写在本文件
LLM_PRIMARY_API_KEY=

# ---------- 备用模型（主力故障时自动降级）----------
# 关键：主备应来自**不同供应商**。同一供应商 + 同一模型作备用时，
# 供应商整体故障（宕机、配额耗尽、网络不通）会让两者一起失败，降级形同虚设。
# 智谱 GLM 同样提供 OpenAI 兼容接口，与 DeepSeek 共用同一个适配器。
# 注意：智谱侧模型名带连字符（glm-5.3），写成 glm5.3 会报 1211「模型不存在」。
# 可用：glm-5.3 / glm-5.3-flash / glm-5.3-flashx / glm-5.2 / glm-5.1 / glm-5 / glm-4.7 等
LLM_FALLBACK_PROVIDER=zhipu
LLM_FALLBACK_MODEL=glm-5.3
LLM_FALLBACK_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_FALLBACK_API_KEY=

# ---------- fast 档：机械步骤用的低延迟模型（分级路由）----------
# 上面 primary/fallback 构成 reasoning 档（强推理，负责规划与归因）；
# 本组构成 fast 档，负责「生成 SQL」这类不需要深度思考的调用点。
#
# 默认指向一个**非推理型**模型的 OpenAI 兼容端点。实测：同样一句简单请求，
# 非推理模型 3.39 秒 / 87 token（思考 token = 0），推理型模型要 40–80 秒 /
# 2,000–4,000 思考 token，低一到两个数量级。
LLM_FAST_PRIMARY_PROVIDER=local
LLM_FAST_PRIMARY_MODEL=glm-5.3
# 例：本地常驻服务 http://127.0.0.1:7863/v1
#     或智谱官方 https://open.bigmodel.cn/api/paas/v4
LLM_FAST_PRIMARY_BASE_URL=http://127.0.0.1:7863/v1
LLM_FAST_PRIMARY_API_KEY=

# fast 档的备用：本地端点不可用时自动降级到这里，不会失败，只是时延回退
LLM_FAST_FALLBACK_PROVIDER=deepseek
LLM_FAST_FALLBACK_MODEL=deepseek-flash
LLM_FAST_FALLBACK_BASE_URL=https://api.deepseek.com/v1
LLM_FAST_FALLBACK_API_KEY=

# ---------- 分级路由表（调用点 -> 档位）----------
# 改路由只需改这一行，不用改代码。调用点名见 src/multiagent/gateway/router.py。
#
# 取值依据（《实施路线图》3.7 的调用点归因实测，20 条用例）：
#   analyst_sql  占模型调用耗时 58% 且是纯机械翻译 -> fast
#   planner      写的验收标准是承重的，切 fast 后核心用例直接失败 -> reasoning
#   analyst_conclude 是真推理，切 fast 后核心用例失败           -> reasoning
LLM_ROUTING={"planner":"reasoning","analyst_sql":"fast","analyst_conclude":"reasoning","reviewer":"reasoning","writer":"reasoning"}

# ---------- 基础设施 ----------
# 与 docker-compose.yml 中的默认值一致
POSTGRES_DSN=postgresql://multiagent:multiagent@localhost:5432/multiagent
# SQL 沙箱专用只读角色（Agent 执行查询用它，不用上面的应用主账号）。
# 权限由 docker/initdb/02-demo-data.sql 授予：仅 SELECT + 5s 语句超时。
POSTGRES_RO_DSN=postgresql://analyst_ro:analyst_ro@localhost:5432/multiagent
REDIS_URL=redis://localhost:6379/0

# ---------- SQL 沙箱约束 ----------
SQL_MAX_ROWS=500
SQL_TIMEOUT_SECONDS=10

# ---------- 执行预算默认值（对应 TaskEvent.budget） ----------
DEFAULT_MAX_STEPS=30
# 任务级 Token 熔断阈值（D2）。定值规则：实测最大 × 1.5、向上取整到万。
# W4 无 reviewer 时最大 20,550 → 40,000；W6 加 reviewer 后最大 37,842 → 60,000；
# W8 全量 50 条最大 35,437；W11 复跑最大 48,051 → 规则给出 80,000。
# 注意：原值 200,000 形同虚设——永远不会触发，等于没有熔断保护。
DEFAULT_MAX_TOKENS=80000
DEFAULT_MAX_RETRIES=2
DEFAULT_TASK_TIMEOUT_SECONDS=300

# 单次模型调用的输出上限。注意：max_tokens 只是上限、不用不收费，
# 给足以免被截断；真正的成本控制靠上面的 DEFAULT_MAX_TOKENS 任务级熔断。
# 实测推理型模型在「生成结构化 DAG」这类任务上需约 2400 输出 token（思考占 ~2100）。
LLM_MAX_OUTPUT_TOKENS=16384

# ---------- 安全基线（W9） ----------
# 输入侧 Prompt Injection / 敏感词过滤；输出侧 DLP 脱敏（身份证/手机号/银行卡/密钥）。
SECURITY_ENABLED=true
SECURITY_DLP_ENABLED=true
# 敏感词（逗号分隔）。默认只收凭据/身份标识类词，避免误伤正常分析问题。
SECURITY_BLOCKED_TERMS=密码,口令,私钥,api key,apikey,secret key,access token,身份证号,银行卡号,信用卡号,cvv

# API Key 鉴权。**共享/对外环境必须开启**；代码默认关闭仅为了本地 stub 与单测兼容。
# 格式：key:role，逗号分隔；角色 = admin | operator | viewer
#   admin    = 提交 + 读取 + 审批
#   operator = 提交 + 读取
#   viewer   = 只读
# 启用鉴权但没有配置任何 Key 时，服务会拒绝启动（fail closed）。
# 真实 Key 只写在 .env；下面只是占位符。
API_AUTH_ENABLED=true
API_KEYS=replace-with-admin-key:admin,replace-with-operator-key:operator,replace-with-viewer-key:viewer

# ---------- 可观测（W10） ----------
# json 便于采集，text 便于本地阅读；不记录原始 prompt/输出（只记长度/哈希/token）。
LOG_LEVEL=INFO
LOG_FORMAT=json
# 模型单价（每 1k token）。本地端点的单位是**积分**，不是货币，仅用于相对成本比较。
LLM_COST_PER_1K={"deepseek-v4.1-flash":0.0355,"glm-5.3":0.1699,"deepseek-v4-pro":0.1309}
COST_UNIT=credits

# ---------- 安全/运维加固（W14） ----------
# 应用层限流：按 API Key 指纹（无 Key 时按 IP）；单进程口径。
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10
# 置于反向代理后时开启（信任 X-Forwarded-For）
TRUST_FORWARDED_FOR=false
# 审计日志：只追加 JSONL（认证失败/提交/审批/任务结束/限流）
AUDIT_ENABLED=true
AUDIT_LOG_PATH=audit/audit.jsonl
# 安全响应头（nosniff / DENY / no-referrer；HTTPS 下加 HSTS）
SECURITY_HEADERS_ENABLED=true
# TLS（可选）：两者都设置时 uvicorn 以 HTTPS 启动；docker compose --tls 会挂载 deploy/tls
# SSL_CERTFILE=/app/tls/cert.pem
# SSL_KEYFILE=/app/tls/key.pem
